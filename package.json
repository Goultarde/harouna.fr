{
  "name": "harouna.fr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build && cd quartz && node ./quartz/bootstrap-cli.mjs build --output ../out/blog",
    "start": "next start",
    "lint": "eslint",
    "blog:dev": "cd quartz && node ./quartz/bootstrap-cli.mjs build --serve",
    "blog:preview": "cd quartz && node ./quartz/bootstrap-cli.mjs build --output ../out/blog && cd .. && npx --yes serve out/blog -l 8080",
    "dev:all": "next dev --webpack & (cd quartz && node ./quartz/bootstrap-cli.mjs build --serve)"
  },
  "dependencies": {
    "next": "16.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.1.2"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ]
}
